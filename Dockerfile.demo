# ARTEX slim demo image — UI + API + server, no live-scan toolbox.
#
# Purpose: a fast, reliable local image for exploring SEEDED demo data end-to-end
# (asset graph, exploration graph, findings, evidence, governance) without the heavy
# third-party pentest toolbox (nuclei/bbot/playwright/...) that the full Dockerfile
# downloads and compiles. Those tools are only needed to run live scans against real
# targets; the demo narrates results that are already in the database.
#
# Build the compiled binary from the project's own build stage first:
#   docker build --target build -t artex-build-stage .
# then this image reuses it (cache-shared with the full build):
#   docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d
#
# Everything the server itself needs (Postgres client libs are not required; it speaks
# the wire protocol directly) is in debian-slim + ca-certificates. A few recon CLIs are
# added so the Tool Execution screen and Bash tool are not completely bare, but the
# agent is not expected to run live scans in demo mode.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl jq ripgrep dnsutils iputils-ping netcat-openbsd whois \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Compiled artex binary (with the Next.js UI embedded) from the project build stage.
COPY --from=artex-build-stage /out/artex /app/artex
COPY start.sh /app/start.sh
COPY skills/ /app/skills/
RUN chmod +x /app/artex /app/start.sh && mkdir -p -m 0700 /app/keys

VOLUME ["/app/data", "/app/keys"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
